#!/usr/bin/env bash

cd "$(dirname "$0")" || exit 1

if ! command -v java >/dev/null; then
	printf "%s: command not found: java\n" "${0##*/}" >&2
	exit 1
fi

major=$(java --version 2>/dev/null | awk 'NR==1 {print int($2)}')
option=
# Suppress warnings on restricted methods
# https://docs.oracle.com/en/java/javase/22/core/restricted-methods.html
if [[ $major -ge 24 ]]; then
	option="--enable-native-access=ALL-UNNAMED"
fi

java $option -cp "bin:lib/*" Main
